# Default wRPC (Borsh) endpoint shown on first launch (users can change it in Settings).
VITE_DEFAULT_NODE_URL=ws://127.0.0.1:43110
# Show the wKLS bridge tab (keep false until the Solana program + bridge daemon are live).
VITE_FEATURE_BRIDGE=false
# Optional donation address shown under WALLET > DONATIONS (leave empty to hide the section).
VITE_DONATION_ADDRESS=
# Base URL of the bridge daemon public API (serves /v1/status, /v1/intents, /v1/burns).
# With BRIDGE_PROXY_TARGET set, use /bridge-api to go through the Vite proxy.
VITE_BRIDGE_API_URL=/bridge-api
# Dev/preview only: forward /bridge-api to a daemon that listens on localhost.
BRIDGE_PROXY_TARGET=http://127.0.0.1:8011
# Solana explorer cluster suffix for wKLS mint links (empty = mainnet, e.g. ?cluster=custom&customUrl=http://127.0.0.1:8899).
VITE_SOLANA_EXPLORER_SUFFIX=
